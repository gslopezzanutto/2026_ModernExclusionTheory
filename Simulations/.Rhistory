# ____________________________________________________________________________________________
# Libraries ----
# ____________________________________________________________________________________________
setwd("~/Escritorio/Gonzalo/PhD/PhD_Project/Paper_1/Paper_1_code/Simulations")
library(deSolve)
library(MVN)
library(tidyverse)
library(ggnewscale)
library(sgof)
rm(list=ls())
start.time = Sys.time()
# ____________________________________________________________________________________________
# Functions ----
# ____________________________________________________________________________________________
source("RandMat_funxs.R")
# ____________________________________________________________________________________________
# Parameters ----
# ____________________________________________________________________________________________
set.seed(86425)
itera = 1000 # Number of iterations
replicate = 1
thold = 1e-5
n_itera = as.integer(runif(itera, min = 50, max = 100))
lambda_itera = runif(itera, min = 0.2, max = 1/3) # mean interaction strength
sig_itera = runif(itera, min = 0.1, max = 0.3)*lambda_itera
rho_itera =  runif(itera, min = -0.95, max = 1) # interaction correlation between species i and j
total_attempts = c()
NFDs = as.data.frame(matrix(0, nrow = 0, ncol = 36)) # Data frame containing the results from one iteration
names(NFDs) = c("matrix", "n", "sigma", "lambda", "rho", "condition", "proportion", "N_star", "no_n_1", "c_ij", "var_c_ij", "r_i", "var_r_i", "eta_i", "var_eta_i", "ND", "mean_ND", "var_ND", "FD", "mean_FD", "var_FD", "cov_NFD", "cor_NFD", "pvalue", "theo_c_ij", "theo_var_c_ij", "theo_r_i", "theo_var_r_i", "theo_eta_i", "theo_var_eta_i", "theo_ND", "theo_FD", "theo_var_ND", "theo_var_FD", "theo_cov_NFD", "theo_cor_NFD")
As_list = list()
# ____________________________________________________________________________________________
# Simulation ----
# ____________________________________________________________________________________________
repeat{
n = n_itera[replicate]
mu_i = rep(1, n) # intrinsic growth-rate of the species
lambda = lambda_itera[replicate]
sig = sig_itera[replicate]
rho = rho_itera[replicate]
M = replicate
print(replicate)
total_attempts = append(total_attempts, replicate)
data = f_OneMatrix(n)
vals = calc_NFDs(n, sig, rho, lambda, mu_i = rep(1, n), Time = seq(0, 10000, 2), thold = 1e-5)
df_comm_mvfit = data.frame("ND" = vals$ND, "FD" = vals$FD)
if(length(df_comm_mvfit$ND) < 8){next}
mvn_result_hz = mvn(data = df_comm_mvfit, mvn_test = "hz") # Henze-Zirkler
if (identical(which(vals$equi > thold), which(vals$solve_densities > 0)) == FALSE || any(vals$solve_densities < 0) == TRUE || any(vals$inv_test[vals$nonsurvivors_indices] > 0) == TRUE){
next
}
lambda = lambda/(1+lambda)
data[,"matrix"] = M
data[,"n"] = n
data[,"sigma"] = sig
data[,"lambda"] = lambda
data[,"rho"] = rho
data[,"condition"] = as.factor(vals$condition)
data[,"N_star"] = vals$solve_densities
data[,"no_n_1"] = sum(data$condition == "no_n_1")/n
data[,"c_ij"] = mean(vals$c_ij[row(vals$c_ij) != col(vals$c_ij)])
data[,"var_c_ij"] = var(c(vals$c_ij), na.rm = TRUE)
data[,"r_i"] = mean(vals$r_i, na.rm = TRUE)
data[,"var_r_i"] = var(vals$r_i, na.rm = TRUE)
data[,"eta_i"] = mean(vals$eta_i, na.rm = TRUE)
data[,"var_eta_i"] = var(vals$eta_i, na.rm = TRUE)
data[,"ND"] = vals$ND
data[,"mean_ND"] = mean(vals$ND, na.rm = TRUE)
data[,"var_ND"] = var(vals$ND, na.rm = TRUE)
data[,"FD"] = vals$FD
data[,"mean_FD"] = mean(vals$FD, na.rm = TRUE)
data[,"var_FD"] = var(vals$FD, na.rm = TRUE)
data[,"cov_NFD"] = cov(vals$ND, vals$FD, use = "complete.obs")
data[,"cor_NFD"] = cor(vals$ND, vals$FD, use = "complete.obs")
data[,"pvalue"] = mvn_result_hz$multivariate_normality[3]
data[data$condition == "resident","proportion"] = (sum(data$condition == "resident")+sum(data$condition == "no_n_1"))/n # Proportion of residents and species with no n-1 community, thus, proportion of extant species in the community
data[data$condition == "no_n_1","proportion"] = sum(data$condition == "no_n_1")/(sum(data$condition == "no_n_1")+sum(data$condition == "resident")) # Proportion of communities with no n-1 community in relation to the number of species that established themselves in the community
data[data$condition == "invader","proportion"] = sum(data$condition == "invader")/sum(data$condition == "excluded") # Proportion of invaders in relation to the number of species that was excluded from the community
data[data$condition == "excluded","proportion"] = sum(data$condition == "excluded")/n # Proportion of excluded species that cannot reinvade
survs = length(vals$solve_densities > 0)
data[,"theo_c_ij"] = 1
data[,"theo_var_c_ij"] = (1/(2*lambda**2) + 1/(2*(1+lambda)**2) - rho/(2*lambda**2))*sig**2
data[,"theo_r_i"] = (1-lambda)/(1-lambda+survs*lambda)
data[,"theo_var_r_i"] = ((sig**2*survs)/(1+lambda*survs)**2)*(1+survs*sig**2)
data[,"theo_eta_i"] = (1-survs)/(1+survs*lambda)
data[,"theo_var_eta_i"] = ((survs*sig**2)/(1+lambda*survs)**2)*((survs/4)+((1+lambda)**2*(1-rho))/(2*lambda**2))
data[,"theo_ND"] = 1-lambda
data[,"theo_FD"] = ((survs-1)/survs)*(1-lambda)
data[,"theo_var_ND"] = (sig**2/survs)*(1-lambda)**2*(((1+rho)/2)+((lambda**2*survs)/4))
data[,"theo_var_FD"] = (sig**2/survs)*(1-lambda)**2*(((1-rho)/2)+((lambda**2*survs)/4))*(1+((1-lambda)/(survs*lambda)))**2
data[,"theo_cov_NFD"] = (sig**2/survs)*(1-lambda)**2*(lambda/4)*(1+((lambda*survs)/(1-lambda)))*(1-lambda)
data[,"theo_cor_NFD"] = 1/sqrt(((1+rho)/2*4/survs*1/lambda**2+1)*((1-rho)/2*4/survs*1/lambda**2+1))
data[,"theo_cor_NFD"] = (survs*lambda**2/2)/sqrt((1+survs*lambda**2/2)^2-rho**2)
NFDs = rbind(NFDs, data)
As_list = append(As_list, list(vals$A))
replicate = replicate + 1
if (replicate > itera) break
}
NFDs$sigma = round(NFDs$sigma, digits = 4)
NFDs$lambda = round(NFDs$lambda, digits = 4)
NFDs$rho = round(NFDs$rho, digits = 4)
# NFDs$pvalue = as.numeric(NFDs$pvalue)
end.time = Sys.time()
time.taken = end.time - start.time
attempts_df = data.frame(x = total_attempts) |> as_tibble() |> count(x, name = "frequency") |> filter(frequency > 1)
# For 1,000 matrices, 1,096 runs were made
# For the parameters of 76 of the 1000 matrices, more than one run was necessary
# write.csv(data, "NFDs.csv")
df = data.frame(matrix(nrow = 0, ncol = 3))
names(df) = c("Emp", "sd", "Theory")
df['c_ij',] = c(mean(NFDs$c_ij),
sd(NFDs$c_ij),
mean(NFDs$theo_c_ij))
df['var_c_ij',] = c(mean(NFDs$var_c_ij),
sd(NFDs$var_c_ij),
mean(NFDs$theo_var_c_ij))
df['r_i',] = c(mean(NFDs$r_i, na.rm = TRUE),
sd(NFDs$r_i, na.rm = TRUE),
mean(NFDs$theo_r_i))
df['eta_i',] = c(mean(NFDs$eta_i, na.rm = TRUE),
sd(NFDs$eta_i, na.rm = TRUE),
mean(NFDs$theo_eta_i))
df["ND",] = c(mean(NFDs$ND, na.rm = TRUE),
sd(NFDs$ND, na.rm = TRUE),
mean(NFDs$theo_ND))
df["var_ND",] = c(mean(NFDs$var_ND),
sd(NFDs$var_ND),
mean(NFDs$theo_var_ND))
df["FD",] = c(mean(NFDs$FD, na.rm = TRUE),
sd(NFDs$FD, na.rm = TRUE),
mean(NFDs$theo_FD))
df["var_FD",] = c(mean(NFDs$var_FD),
sd(NFDs$var_FD),
mean(NFDs$theo_cov_NFD))
df["cov_NFD",] = c(mean(NFDs$cov_NFD),
sd(NFDs$cov_NFD),
mean(NFDs$theo_cov_NFD))
df["cor_NFD",] = c(mean(NFDs$cor_NFD),
sd(NFDs$cor_NFD),
mean(NFDs$theo_cor_NFD))
df[,"z-score"] = (df[,1] - df[,3])/df[,2]
df = round(df, digits = 6)
df
# ____________________________________________________________________________________________
# Regressions ----
# ____________________________________________________________________________________________
R_squares = data.frame(matrix(nrow = 0, ncol = 2))
names(R_squares) = c("x", "Rsquare")
R_squares["theo_ND",] = c("lambda",
get_Rsquare(data = NFDs,
y = NFDs$theo_ND,
x = NFDs$lambda))
R_squares["theo_FD",] = c("lambda",
get_Rsquare(y = NFDs$theo_FD,
x = NFDs$lambda))
R_squares["mean_ND",] = c("lambda",
get_Rsquare(y = NFDs$mean_ND,
x = NFDs$lambda))
R_squares["mean_FD",] = c("lambda",
get_Rsquare(y = NFDs$mean_FD,
x = NFDs$lambda))
R_squares["theo_var_ND",] = c("rho",
get_Rsquare(y = NFDs$theo_var_ND/(NFDs$sigma**2/NFDs$n*(1-NFDs$lambda)**2),
x = NFDs$rho))
R_squares["theo_var_FD",] = c("rho",
get_Rsquare(y = NFDs$theo_var_FD/(NFDs$sigma**2/NFDs$n*(1-NFDs$lambda)**2),
x = NFDs$rho))
R_squares["var_ND",] = c("rho",
get_Rsquare(y = NFDs$var_ND/(NFDs$sigma**2/NFDs$n*(1-NFDs$lambda)**2),
x = NFDs$rho))
R_squares["var_FD",] = c("rho",
get_Rsquare(y = NFDs$var_FD/(NFDs$sigma**2/NFDs$n*(1-NFDs$lambda)**2),
x = NFDs$rho))
R_squares["theo_cor_NFD",] = c("lambda",
get_Rsquare(y = NFDs$theo_cor_NFD,
x = NFDs$lambda))
R_squares["cor_NFD",] = c("lambda",
get_Rsquare(y = NFDs$cor_NFD,
x = NFDs$lambda))
R_squares$Rsquare = as.numeric(R_squares$Rsquare)
R_squares$Rsquare = round(R_squares$Rsquare, digits = 4)
R_squares
(time.taken)
