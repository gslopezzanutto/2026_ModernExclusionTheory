geom_point(aes(y = theo_cor_NFD), shape = 16, colour = "purple", size = 1)+
geom_smooth(aes(y = cor_NFD), method = "lm", se = FALSE, colour = "plum2")+
geom_smooth(aes(y = theo_cor_NFD), method = "lm", se = FALSE, colour = "purple")+
ylim(0,1)+
