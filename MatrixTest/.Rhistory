emp_mean_vec_Gor = c(mean(data_Gor$mean_ND), mean(data_Gor$mean_FD))
emp_covmat_Gor = matrix(c(var(data_Gor$ND, na.rm = TRUE), cov(data_Gor$ND, data_Gor$FD, use = "complete.obs"),
cov(data_Gor$ND, data_Gor$FD, use = "complete.obs"), var(data_Gor$FD, na.rm = TRUE)),
2,2)
emp_AIC_test_Gor = AIC_test(data = subset(data_Gor, select = c(ND, FD)),
mean_vec = emp_mean_vec_Gor,
cov_mat = emp_covmat_Gor,
k = 5)
theo_AIC_test_Gor = AIC_test(data = subset(data_Gor, select = c(ND, FD)),
mean_vec = mean_vec_Gor,
cov_mat = cov_mat_Gor,
k = 5)
AIC_Res_Gor = c(emp_AIC_test_Gor, theo_AIC_test_Gor)
