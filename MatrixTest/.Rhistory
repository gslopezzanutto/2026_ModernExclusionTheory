A_Ser = read.delim("U_matrix_Serengeti.txt", header = TRUE, row.names = 1)
A_Ser = A_Ser[sort(rownames(A_Ser)), sort(colnames(A_Ser))]
A_Ser = as.matrix(A_Ser)
mu_ip_Ser = parms |> filter(PA == "Serengeti") |> arrange(Species) |> pull(Rmax) |> as.numeric()
sp = parms |> filter(PA == "Serengeti") |> arrange(Species) |> pull(Species)
site = parms |> filter(PA == "Serengeti") |> pull(PA)
n_Ser = length(A_Ser[1,])
thold = 1e-5
A_Ser = transA(A = A_Ser, mu_ip = mu_ip_Ser)
mu_ip_Ser = rep(1, length(mu_ip_Ser))
data_Ser = CommNFD(A = A_Ser, mu_i = mu_ip_Ser, thold = thold)
data_Ser = add_column(data_Ser, sp, .before = 1)
data_Ser = add_column(data_Ser, site, .before = 1)
lambda_Ser = comp_lambda(A_Ser)
sig_Ser = sqrt(var(as.vector(A_Ser)))
rho_Ser = cor(A_Ser[upper.tri(A_Ser)],A_Ser[lower.tri(A_Ser)])
mean_niche_Ser = 1-lambda_Ser
var_niche_Ser = (sig_Ser**2/(n_Ser*(1+lambda_Ser)**2))*(((1+rho_Ser)/2)+((n_Ser*lambda_Ser**2)/(4*(1+lambda_Ser)**2)))
mean_fitn_Ser = ((n_Ser-1)/n_Ser)*(1-lambda_Ser)
var_fitn_Ser = (sig_Ser**2/(n_Ser*(1+lambda_Ser)**2))*(((1-rho_Ser)/2)+((n_Ser*lambda_Ser**2)/(4*(1+lambda_Ser)**2)))*(1+((1-lambda_Ser)/(lambda_Ser*n_Ser)))
cov_nf_Ser = sig_Ser**2/n_Ser*(1-lambda_Ser)**2*1/4*((1-lambda_Ser)*lambda_Ser+n_Ser*lambda_Ser**2)
cov_mat_Ser = matrix(c(var_niche_Ser, cov_nf_Ser, cov_nf_Ser, var_fitn_Ser), 2, 2)
mean_vec_Ser = c(mean_niche_Ser, mean_fitn_Ser)
model_ellipse_Ser = make_ellipse(mean_vec = mean_vec_Ser, cov_mat = cov_mat_Ser)
ggplot(data = subset(data_Ser, condition %in% c("resident", "excluded")),
aes(y = FD,
x = ND))+
geom_point(aes(shape = condition))+
scale_shape_manual(values = c(1,16))+
geom_abline(colour = "red") +
stat_ellipse(geom = "polygon",
fill = 4,
type = "norm",
colour = "black",
alpha = 0.05,
level = 0.95,
linetype = 8)+
geom_text(aes(label = sp),
hjust = -0.2,
vjust = 0.1,
size = 3.5)+
geom_path(data = model_ellipse_Ser,
aes(x = x, y = y),
linewidth = 1,
linetype = 8,
color = "red")+
stat_summary(aes(x = mean_ND, y = mean_FD), geom = "point", fun = "mean", colour = "black", shape = 4, size = 4)+
annotate(x = mean_niche_Ser, y = mean_fitn_Ser, geom = "point", colour = "red", shape = 4, size = 4)+
ylim(0, 1.06)+
xlim(0,1.06)+
coord_fixed(ratio = 1)+
ggtitle("(C) Serengeti")+
labs(y = "Fitness differences",
x = "Niche differences")+
theme_bw()+
theme(legend.position = "none",
axis.text = element_text(size = 12),
axis.title = element_text(size = 14))
