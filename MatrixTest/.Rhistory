# Functions ----
# ____________________________________________________________________________________________
source("MatTest_funxs.R")
# ____________________________________________________________________________________________
# Parameters ----
# ____________________________________________________________________________________________
parms = read.csv("MCT_combined_data.csv", header = TRUE)
inv = TRUE
# ____________________________________________________________________________________________
# Test - Gorongosa ----
# ____________________________________________________________________________________________
A_Gor = read.delim("U_matrix_Gorongosa.txt", header = TRUE, row.names = 1)
A_Gor = A_Gor[sort(rownames(A_Gor)), sort(colnames(A_Gor))]
A_Gor = as.matrix(A_Gor)
mu_ip_Gor = parms |> filter(PA == "Gorongosa") |> arrange(Species) |> pull(Rmax) |> as.numeric()
sp = parms |> filter(PA == "Gorongosa") |> arrange(Species) |> pull(Species)
site = parms |> filter(PA == "Gorongosa") |> pull(PA)
n_Gor = length(A_Gor[1,])
thold = 1e-5
A_Gor = transA(A = A_Gor, mu_ip = mu_ip_Gor)
mu_ip_Gor = rep(1, length(mu_ip_Gor))
data_Gor = CommNFD(A = A_Gor, mu_i = mu_ip_Gor, thold = thold)
data_Gor = add_column(data_Gor, sp, .before = 1)
data_Gor = add_column(data_Gor, site, .before = 1)
lambda_Gor = comp_lambda(A_Gor)
sig_Gor = sqrt(var(as.vector(A_Gor)))
rho_Gor = cor(A_Gor[upper.tri(A_Gor)],A_Gor[lower.tri(A_Gor)])
mean_niche_Gor = 1-lambda_Gor
var_niche_Gor = (sig_Gor**2/(n_Gor*(1+lambda_Gor)**2))*(((1+rho_Gor)/2)+((n_Gor*lambda_Gor**2)/(4*(1+lambda_Gor)**2)))
mean_fitn_Gor = ((n_Gor-1)/n_Gor)*(1-lambda_Gor)
var_fitn_Gor = (sig_Gor**2/(n_Gor*(1+lambda_Gor)**2))*(((1-rho_Gor)/2)+((n_Gor*lambda_Gor**2)/(4*(1+lambda_Gor)**2)))*(1+((1-lambda_Gor)/(lambda_Gor*n_Gor)))
cov_nf_Gor = sig_Gor**2/n_Gor*(1-lambda_Gor)**2*1/4*((1-lambda_Gor)*lambda_Gor+n_Gor*lambda_Gor**2)
cov_mat_Gor = matrix(c(var_niche_Gor, cov_nf_Gor, cov_nf_Gor, var_fitn_Gor), 2, 2)
mean_vec_Gor = c(mean_niche_Gor, mean_fitn_Gor)
model_ellipse_Gor = make_ellipse(mean_vec = mean_vec_Gor, cov_mat = cov_mat_Gor)
ggplot(data = subset(data_Gor, condition %in% c("resident", "excluded")),
aes(y = FD,
x = ND))+
geom_point(aes(shape = condition))+
scale_shape_manual(values = c(1,16))+
geom_abline(colour = "red") +
stat_ellipse(geom = "polygon",
fill = 4,
type = "norm",
colour = "black",
alpha = 0.05,
level = 0.95,
linetype = 8)+
geom_text(aes(label = sp),
hjust = -0.2,
vjust = 0.1,
size = 3.5)+
geom_path(data = model_ellipse_Gor,
aes(x = x, y = y),
linewidth = 1,
linetype = 8,
color = "red")+
stat_summary(aes(x = mean_ND, y = mean_FD), geom = "point", fun = "mean", colour = "black", shape = 4, size = 4)+
annotate(x = mean_niche_Gor, y = mean_fitn_Gor, geom = "point", colour = "red", shape = 4, size = 4)+
ylim(0.44, 1)+
xlim(0.44, 1)+
coord_fixed(ratio = 1)+
ggtitle("(A) Gorongosa")+
labs(y = "Fitness differences",
x = " ")+
theme_bw()+
theme(legend.position = "none",
axis.text = element_text(size = 12),
axis.title = element_text(size = 14))
